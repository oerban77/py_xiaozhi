{
  "entry": "main.py",
  "name": "py-xiaozhi",
  "display_name": "Xiaozhi",
  "version": "2.1.2",
  "icon": "assets/icon.png",
  "pyinstaller": {
    "onefile": false,
    "windowed": true,
    "add_data": [
      "models:models",
      "scripts:scripts",
      "src:src",
      "libs:libs",
      "assets:assets"
    ],
    "hidden_import": [
      "numpy",
      "sounddevice",
      "soxr",
      "opuslib",
      "opuslib.api.decoder",
      "opuslib.api.encoder",
      "sherpa_onnx",
      "cv2",
      "PIL",
      "PIL.ImageGrab",
      "mutagen",
      "mutagen.id3",
      "pyperclip",
      "pynput",
      "pynput.keyboard",
      "machineid",
      "psutil",
      "platformdirs",
      "cryptography",
      "cryptography.hazmat",
      "aiohttp",
      "requests",
      "websockets",
      "paho",
      "paho.mqtt",
      "paho.mqtt.client",
      "openai",
      "httpx",
      "pypinyin",
      "qasync",
      "textual",
      "win32com",
      "win32com.client",
      "winreg",
      "ctypes.wintypes",
      "comtypes",
      "comtypes.client",
      "pycaw",
      "pycaw.pycaw"
    ],
    "collect_all": [
      "sherpa_onnx"
    ],
    "noupx": true,
    "clean": true,
    "noconfirm": true
  },
  "platforms": {
    "macos": {
      "bundle_identifier": "com.py-xiaozhi.app",
      "minimum_system_version": "10.13",
      "category": "public.app-category.productivity",
      "microphone_usage_description": "This app needs access to the microphone for recording",
      "speech_recognition_usage_description": "This app needs speech recognition to understand voice commands",
      "camera_usage_description": "This app needs camera access for photo or video",
      "copyright": "© 2024 Company. All rights reserved.",
      "dmg": {
        "volname": "Xiaozhi Installer",
        "window_size": [
          600,
          450
        ],
        "icon_size": 100,
        "format": "UDZO"
      }
    },
    "windows": {
      "inno_setup": {
        "create_desktop_icon": true,
        "create_start_menu_icon": true,
        "allow_run_after_install": true,
        "languages": [
          "english"
        ]
      },
      "pyinstaller": {
        "contents_directory": "."
      }
    },
    "linux": {
      "deb": {
        "package": "py-xiaozhi",
        "section": "utils",
        "priority": "optional",
        "desktop_entry": true,
        "categories": [
          "Utility"
        ]
      }
    }
  }
}